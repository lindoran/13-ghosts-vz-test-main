diff --git a/verify_font_cache.py b/verify_font_cache.py
new file mode 100644
index 0000000..c024d6f
--- /dev/null
+++ b/verify_font_cache.py
@@ -0,0 +1,63 @@
+import z80, re, sys
+ORG=0x7AE8
+b=open('ghost13_vz.bin','rb').read()
+rom=bytearray(open('VZ200_basic_ROM_listing/refrence_rom.bin','rb').read())
+txt=open('VZ200_basic_ROM_listing/corrected_table.asm').read()
+rows=re.findall(r'DEFB\s+((?:0x[0-9A-Fa-f]{2},?){5})',txt)
+tab=bytes(int(x,16) for r in rows for x in r.split(','))
+
+def ref_cache(t):
+    out=bytearray()
+    for g in range(64):
+        cols=t[g*5:g*5+5]
+        for r in range(8):
+            px=[3 if not (c>>r)&1 else 0 for c in cols]+[0,0,0]
+            out.append(px[0]<<6|px[1]<<4|px[2]<<2|px[3])
+            out.append(px[4]<<6|px[5]<<4|px[6]<<2|px[7])
+    return bytes(out)
+
+# locate vz_boot's "ld sp,0FFFFh / call X / jp Y"
+vb=b.find(bytes([0xF3,0x3E,0x08,0xD3,0x70])); k=b.find(bytes([0x31,0xFF,0xFF,0xCD]),vb)
+call_at=ORG+k+3
+jp_at=call_at+3
+assert b[k+6]==0xC3
+print("call build_font_cache @",hex(call_at),"-> game entry jp @",hex(jp_at),"target",hex(b[k+7]|b[k+8]<<8))
+
+def run(poison):
+    m=z80.Z80Machine()
+    r=bytearray(rom)
+    if poison: r[0x3B94:0x3B94+320]=bytes([0x55])*320   # trash the ROM font
+    m.set_memory_block(0,bytes(r))
+    m.set_memory_block(ORG,b)           # RAM-backed 0x4000+ in this sim
+    m.pc=ORG; m.sp=0xFFFF
+    m.set_breakpoint(jp_at)
+    for _ in range(200):
+        m.ticks_to_stop=2_000_000
+        ev=m.run()
+        if m.pc==jp_at: break
+    mem=bytes(m.get_state_view())[0x2C:0x2C+65536]
+    return m.pc, mem[0x5A00:0x5A00+1024]
+
+for poison in (False,True):
+    pc,cache=run(poison)
+    print(f"poisoned_rom={poison}: stopped pc={pc:#06x}",
+          "cache == corrected-table reference:", cache==ref_cache(tab),
+          "| == buggy-ROM reference:", cache==ref_cache(bytes(rom[0x3B94:0x3B94+320])))
+
+from PIL import Image  # optional: contact-sheet PNG
+pc,cache=run(True)
+S=6; names="@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^<- !\"#$%&'()*+,-./0123456789:;<=>?"
+fixed=[0x18,0x1F,0x23,0x24,0x2A,0x2C,0x33,0x35,0x3C,0x3E]
+img=Image.new("RGB",(16*9*S,4*9*S),(0,40,0))
+for g in range(64):
+    gx,gy=(g%16)*9*S,(g//16)*9*S
+    for r in range(8):
+        for bi in range(2):
+            byte=cache[g*16+r*2+bi]
+            for p in range(4):
+                if (byte>>(6-2*p))&3:
+                    x=(bi*4+p)
+                    for dx in range(S):
+                        for dy in range(S):
+                            img.putpixel((gx+x*S+dx,gy+r*S+dy),(255,120,0) if g in fixed else (230,230,230))
+img.save('font_cache_corrected.png'); print("fixed glyphs (orange):",[hex(f) for f in fixed])
diff --git a/verify_hud_render.py b/verify_hud_render.py
new file mode 100644
index 0000000..bd529e8
--- /dev/null
+++ b/verify_hud_render.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Run the real boot + vz_draw_hud_row in the Z80 emulator for the NEW build
+(embedded corrected font) and an OLD build (ROM font), render the HUD strip.
+usage: verify_hud_render.py NEW.bin NEW.map OLD.bin OLD.map"""
+import sys, re, z80
+from PIL import Image
+ORG=0x7AE8
+ROM=bytearray(open('VZ200_basic_ROM_listing/refrence_rom.bin','rb').read())
+
+def syms(p):
+    return {m.group(1):int(m.group(2),16) for m in re.finditer(r'^(\w+)\s+= \$([0-9A-F]+)',open(p).read(),re.M)}
+
+def run_hud(binp,mapp,fields):
+    b=open(binp,'rb').read(); S=syms(mapp)
+    m=z80.Z80Machine()
+    m.set_memory_block(0,bytes(ROM)); m.set_memory_block(ORG,b)
+    # boot up to (not including) the jump into the game
+    k=b.find(bytes([0x31,0xFF,0xFF,0xCD]),S['vz_boot']-ORG); jp_at=ORG+k+6
+    m.pc=S['vz_boot']; m.sp=0xFFFF; m.set_breakpoint(jp_at)
+    for _ in range(300):
+        m.ticks_to_stop=2_000_000; m.run()
+        if m.pc==jp_at: break
+    else: raise SystemExit("boot did not reach game entry")
+    m.clear_breakpoint(jp_at)
+    for addr,val in fields.items():           # TRS-80 ASCII bytes in HUD row
+        m.set_memory_block(addr,bytes([val]))
+    ret=0x0100; m.set_memory_block(ret,b'\x00')
+    m.sp=0xFFF0; m.set_memory_block(0xFFF0,bytes([ret&255,ret>>8]))
+    m.pc=S['vz_draw_hud_row']; m.set_breakpoint(ret)
+    for _ in range(300):
+        m.ticks_to_stop=2_000_000; m.run()
+        if m.pc==ret: break
+    else: raise SystemExit("HUD routine did not return")
+    return bytes(m.get_state_view())[0x2C+0x7000:0x2C+0x7800]
+
+def hud_fields(score,level,ghost):
+    f={}
+    for i,c in enumerate(score): f[0x53CC+i]=ord(c)
+    f[0x53F2]=ord(level[0]); f[0x53F3]=ord(level[1])
+    f[0x53FD]=ord(ghost[0]); f[0x53FE]=ord(ghost[1])
+    return f
+
+PAL={0:(0,60,0),1:(230,230,60),2:(60,60,230),3:(255,255,255)}
+def strip(vram,S=6):
+    img=Image.new("RGB",(128*S,8*S))
+    for r in range(8):
+        for x in range(128):
+            v=(vram[(56+r)*32+x//4]>>(6-2*(x%4)))&3
+            for dx in range(S):
+                for dy in range(S): img.putpixel((x*S+dx,r*S+dy),PAL[v])
+    return img
+
+tests={"A (digits 3 and 5, the fixed glyphs)":("33355","53","35"),
+       "B (digits unchanged by the fix)":("01247","68","09")}
+new,newm,old,oldm=sys.argv[1:5]
+rows=[];ok=True
+for name,(sc,lv,gh) in tests.items():
+    f=hud_fields(sc,lv,gh)
+    vn=run_hud(new,newm,f); vo=run_hud(old,oldm,f)
+    same=vn[56*32:]==vo[56*32:]
+    print(f"test {name}: new vs old HUD strip identical = {same}")
+    rows += [(f"OLD ROM font  {sc} L{lv} G{gh}",strip(vo)),(f"NEW corrected  {sc} L{lv} G{gh}",strip(vn))]
+    if name.startswith("B") and not same: ok=False
+    if name.startswith("A") and same: ok=False
+W=rows[0][1].width; H=rows[0][1].height
+sheet=Image.new("RGB",(W,(H+6)*len(rows)),(20,20,20))
+for i,(n,im) in enumerate(rows): sheet.paste(im,(0,i*(H+6)))
+sheet.save("hud_render_corrected_font.png")
+print("expectation (A differs, B identical):","PASS" if ok else "FAIL")
